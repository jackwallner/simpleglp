opt_out_usage

default_platform(:ios)

APP_BUNDLE_ID    = "com.jackwallner.glp"
WIDGET_BUNDLE_ID = "com.jackwallner.glp.widget"
WATCH_BUNDLE_ID  = "com.jackwallner.glp.watch"
APP_GROUP_ID     = "group.com.jackwallner.glp"
TEAM_ID          = "YXG4MP6W39"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["ASC_API_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"]
  )
end

platform :ios do
  desc "Create the App Store Connect app record + bundle IDs (idempotent)"
  lane :register_app do
    produce(
      api_key: asc_api_key,
      app_identifier: APP_BUNDLE_ID,
      app_name: "Simple GLP",
      language: "English",
      app_version: "1.0",
      sku: "simpleglp-1",
      team_id: TEAM_ID,
      skip_itc: false,
      skip_devcenter: false,
      enable_services: {
        healthkit: "on",
        app_group: "on"
      }
    )
  end

  desc "Upload metadata to App Store Connect (no screenshots, no binary, no submit)"
  lane :upload_metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_BUNDLE_ID,
      force: true,
      precheck_include_in_app_purchases: false,
      version_check_wait_retry_limit: 1,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      overwrite_screenshots: false,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false
      }
    )
  end

  desc "Build and upload to TestFlight"
  lane :ship_testflight do
    increment_build_number(
      build_number: number_of_commits,
      xcodeproj: "SimpleGLP.xcodeproj"
    )

    build_app(
      scheme: "SimpleGLP",
      project: "SimpleGLP.xcodeproj",
      export_method: "app-store",
      include_bitcode: false
    )

    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: false,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH]
    )
  end

  desc "Build, upload to TestFlight, then tag and push to GitHub"
  lane :push do
    # Bump build number, archive, and upload to TestFlight
    increment_build_number(
      build_number: number_of_commits,
      xcodeproj: "SimpleGLP.xcodeproj"
    )

    build_app(
      scheme: "SimpleGLP",
      project: "SimpleGLP.xcodeproj",
      export_method: "app-store",
      include_bitcode: false
    )

    upload_to_testflight(
      api_key: asc_api_key,
      skip_waiting_for_build_processing: false,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH]
    )

    # Get version info for the tag
    version = get_version_number(
      xcodeproj: "SimpleGLP.xcodeproj",
      target: "SimpleGLP"
    )
    build = get_build_number(xcodeproj: "SimpleGLP.xcodeproj")

    # Commit and push to GitHub
    git_add(path: ".")
    git_commit(
      path: ".",
      message: "chore: build #{version} (#{build}) for TestFlight"
    )
    add_git_tag(tag: "v#{version}-build-#{build}")
    push_to_git_remote(
      remote: "origin",
      tags: true
    )
  end
end
