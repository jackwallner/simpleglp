    "We'll ask permission to send notifications. If you decline, reminders won't fire. You can enable them later in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll ask permission to send notifications. If you decline, reminders won't fire. You can enable them later in iOS Settings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos pedir permissão para enviar notificações. Se você não permitir, os lembretes não serão enviados. Você pode ativá-los depois nos Ajustes do iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirim göndermek için izin isteyeceğiz. İzin vermezsen hatırlatmalar gönderilmez. Bu izni daha sonra iOS Ayarları'ndan açabilirsin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te pediremos permiso para enviar notificaciones. Si lo rechazas, no recibirás recordatorios. Puedes activarlos después en Configuración de iOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprosimy o zgodę na powiadomienia. Jeśli odmówisz, nie będą przychodzić. Zgodę możesz włączyć później w Ustawieniach iOS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會詢問你是否允許傳送通知。若你拒絕，就不會收到提醒。你之後可在 iOS「設定」中開啟提醒。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы попросим разрешение на отправку уведомлений. Если вы откажетесь, напоминания не будут приходить. Позже вы сможете включить их в настройках iOS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Értesítési engedélyt kérünk. Ha nem engedélyezed, nem kapsz emlékeztetőket. Később az iOS Beállításokban bekapcsolhatod őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti chiederemo il permesso di inviare notifiche. Se rifiuti, non riceverai promemoria. Puoi attivarli più tardi in Impostazioni iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir fragen dich, ob wir Mitteilungen senden dürfen. Wenn du ablehnst, erhältst du keine Erinnerungen. Du kannst sie später in den iOS-Einstellungen aktivieren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous vous demanderons l’autorisation d’envoyer des notifications. Si vous refusez, vous ne recevrez pas de rappels. Vous pourrez les activer plus tard dans les réglages d’iOS."
          }
        }
      }
    },
