        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skipped on days you’ve already logged your pill."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O lembrete é ignorado nos dias em que você já registrou o comprimido."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablet kaydını zaten yaptığın günlerde hatırlatma gönderilmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No recibirás recordatorios los días que ya hayas registrado la pastilla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienie nie pojawi się w dni, w które zapisano już tabletkę."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已記錄藥錠的當天不會再提醒。"
