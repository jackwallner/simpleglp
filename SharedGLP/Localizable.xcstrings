    "When enabled, you get a second nudge if today’s pill isn’t logged a few hours after its time.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, you get a second nudge if today’s pill isn’t logged a few hours after its time."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, você recebe outro lembrete se não registrar o comprimido algumas horas após o horário previsto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açıksa, tabletini planlanan saatten birkaç saat sonra kaydetmediğinde ikinci bir hatırlatma alırsın."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si lo activas, recibirás otro aviso si no registras la pastilla unas horas después de la hora prevista."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu otrzymasz drugie przypomnienie, jeśli nie zapiszesz tabletki kilka godzin po planowanej porze."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，若預定時間過了幾小時仍未記錄藥錠，會再提醒一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если функция включена, через несколько часов после запланированного времени придет повторное напоминание, если таблетка не записана."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolás után újabb emlékeztetőt kapsz, ha a tervezett időpont után néhány órával sem rögzítetted a tablettát."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivata, riceverai un secondo promemoria se non registri la compressa qualche ora dopo l’orario previsto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, erhältst du eine zweite Erinnerung, falls du die Tablette einige Stunden nach der geplanten Zeit nicht erfasst hast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cette option est activée, vous recevrez un second rappel si le comprimé n’est pas enregistré quelques heures après l’heure prévue."
          }
        }
      }
    },
    "When enabled, the app analyzes your shot history and notifies you about upcoming dose days.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, the app analyzes your shot history and notifies you about upcoming dose days."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o app analisa seu histórico de injeções e avisa sobre os próximos dias de dose."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık olduğunda uygulama iğne geçmişini inceler ve yaklaşan doz günlerini bildirir."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarlo, la app analiza tu historial de inyecciones y te avisa de los próximos días de dosis."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu aplikacja analizuje historię zastrzyków i powiadamia o nadchodzących dniach dawki."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，App 會分析你的注射記錄，並提醒即將到來的用藥日。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если функция включена, приложение анализирует историю уколов и сообщает о предстоящих днях приема дозы."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolás után az app elemzi az injekciós előzményeket, és értesít a közelgő adagokról."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivata, l’app analizza la cronologia delle iniezioni e avvisa dei prossimi giorni della dose."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, analysiert die App deine Spritzenhistorie und informiert dich über anstehende Dosistage."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cette option est activée, l’app analyse l’historique des injections et vous informe des prochains jours de dose."
          }
        }
      }
    },
