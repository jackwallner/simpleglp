    "Set your first dose and we'll keep the rhythm from there.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your first dose and we'll keep the rhythm from there."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina sua primeira dose e acompanhe os próximos registros a partir daí."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk dozunu ayarla, sonraki kayıtları buna göre takip et."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura tu primera dosis y lleva el seguimiento a partir de ahí."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw pierwszą dawkę, a kolejne wpisy będą do niej dopasowane."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定第一劑後，即可從這裡開始追蹤。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите первую дозу, а дальше приложение поможет вести записи."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Állítsd be az első adagot, a további bejegyzéseket pedig ehhez igazítjuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la prima dose e continua a registrare da lì."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege deine erste Dosis fest und erfasse danach die weiteren Einnahmen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez votre première dose, puis suivez les prises suivantes."
          }
        }
      }
    },
    "A nudge each day, skipped once you've logged your pill.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A nudge each day, skipped once you've logged your pill."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete diário, suspenso quando você registra o comprimido."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her gün hatırlatır, tableti kaydettiğinde o gün için atlanır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio diario que se omite cuando registras la pastilla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Codzienne przypomnienie, pomijane po zapisaniu tabletki."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每天提醒，記錄藥錠後當天不再提醒。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ежедневное напоминание, которое пропускается после записи таблетки."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Napi emlékeztető, amely a tabletta rögzítése után kimarad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria quotidiano, saltato dopo aver registrato la compressa."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine tägliche Erinnerung, die nach dem Erfassen der Tablette ausfällt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel quotidien, ignoré après l’enregistrement du comprimé."
          }
        }
      }
    },
    "A gentle nudge so a busy week doesn't push your shot.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle nudge so a busy week doesn't push your shot."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um lembrete para ajudar a não esquecer a injeção em uma semana corrida."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yoğun bir haftada iğne gününü unutmaman için hatırlatma."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recordatorio para que una semana ocupada no te haga olvidar la inyección."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienie, które pomaga pamiętać o zastrzyku w zabieganym tygodniu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "忙碌的一週也能記得注射的提醒。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание, чтобы не забыть об уколе даже в загруженную неделю."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Emlékeztető, hogy egy sűrű héten se feledkezz meg az injekcióról."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un promemoria per non dimenticare l’iniezione anche nelle settimane piene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Erinnerung, damit du die Spritze auch in einer vollen Woche nicht vergisst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rappel pour ne pas oublier l’injection pendant une semaine chargée."
          }
        }
      }
    },
