    "Logs your GLP-1 shot or pill as taken now. On a pill with a wait, it starts the countdown.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs your GLP-1 shot or pill as taken now. On a pill with a wait, it starts the countdown."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra agora sua injeção ou comprimido GLP-1. Se houver espera para o comprimido, inicia a contagem regressiva."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "GLP-1 iğneni veya tabletini şimdi alınmış olarak kaydeder. Tablet için bekleme varsa sayacı başlatır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra ahora tu inyección o pastilla GLP-1. Si la pastilla requiere espera, inicia la cuenta regresiva."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje przyjęcie zastrzyku lub tabletki GLP-1. Przy tabletce rozpoczyna odliczanie, jeśli obowiązuje czas oczekiwania."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即記錄已使用的 GLP-1 注射或藥錠。若藥錠需要等待，會開始倒數。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывает прием инъекции или таблетки GLP-1. Для таблетки запускает отсчет ожидания, если он настроен."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Rögzíti a GLP-1 injekció vagy tabletta bevételét. Tablettánál elindítja a várakozási időt, ha be van állítva."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra l’assunzione dell’iniezione o compressa GLP-1. Per la compressa avvia l’attesa, se prevista."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst deine GLP-1-Spritze oder Tablette als eingenommen. Bei einer Tablette startet es die Wartezeit, falls eingerichtet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre votre injection ou comprimé de GLP-1 comme pris. Pour un comprimé, lance le délai d’attente s’il est configuré."
          }
        }
      }
    },
