    "Free for %@. Auto-renews; cancel anytime in Settings at least 24h before it ends.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free for %@. Auto-renews; cancel anytime in Settings at least 24h before it ends."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grátis por %1$@. A assinatura renova automaticamente. Cancele nos Ajustes pelo menos 24 horas antes do fim."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ boyunca ücretsiz. Otomatik yenilenir. Bitmeden en az 24 saat önce Ayarlar'dan iptal edebilirsin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis durante %1$@. Se renueva automáticamente. Puedes cancelarla en Configuración al menos 24 horas antes de que termine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bezpłatnie przez %1$@. Subskrypcja odnawia się automatycznie. Anuluj ją w Ustawieniach co najmniej 24 godziny przed końcem."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 內免費，之後會自動續訂。請至少在結束前 24 小時到設定中取消。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бесплатно в течение %1$@. Затем подписка продлится автоматически. Отмените ее в настройках не позднее чем за 24 часа до окончания."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ingyenes. Ezután automatikusan megújul. A lejárat előtt legalább 24 órával mondd le a Beállításokban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratis per %1$@. Poi si rinnova automaticamente. Puoi annullare nelle Impostazioni almeno 24 ore prima della scadenza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für %1$@ kostenlos. Danach verlängert sich das Abo automatisch. Kündige es mindestens 24 Stunden vor Ablauf in den Einstellungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gratuit pendant %1$@. Renouvellement automatique ensuite. Annulez dans les Réglages au moins 24 heures avant la fin."
          }
        }
      }
    },
