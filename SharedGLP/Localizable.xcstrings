    "Logging your pill starts this countdown. Set it to match your prescriber’s instructions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logging your pill starts this countdown. Set it to match your prescriber’s instructions."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao registrar o comprimido, a contagem começa. Ajuste o tempo conforme a orientação de quem prescreveu o medicamento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tableti kaydettiğinde geri sayım başlar. Süreyi ilacını yazan sağlık uzmanının talimatlarına göre ayarla."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al registrar la pastilla comienza la cuenta regresiva. Ajusta el tiempo según las indicaciones de quien te recetó el medicamento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisanie tabletki rozpoczyna odliczanie. Ustaw czas zgodnie z zaleceniami lekarza."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄藥錠後會開始倒數。請依處方醫療人員的指示設定時間。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После записи таблетки начнется обратный отсчет. Установите время по указаниям специалиста, назначившего препарат."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tabletta rögzítése elindítja a visszaszámlálást. Az időt az orvos utasításai szerint állítsd be."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione della compressa avvia il conto alla rovescia. Imposta la durata secondo le indicazioni di chi ti ha prescritto il farmaco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald du die Tablette erfasst, startet der Countdown. Stelle die Dauer nach den Vorgaben deiner Arztpraxis ein."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’enregistrement du comprimé lance le compte à rebours. Réglez la durée selon les consignes du professionnel qui vous suit."
          }
        }
      }
    },
