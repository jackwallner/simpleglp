    "Reminders won't fire until you turn on notifications for Simple GLP in iOS Settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders won't fire until you turn on notifications for Simple GLP in iOS Settings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes só funcionarão quando você ativar as notificações do Simple GLP nos Ajustes do iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS Ayarları'nda Simple GLP bildirimlerini açana kadar hatırlatmalar gönderilmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios no se enviarán hasta que actives las notificaciones de Simple GLP en Configuración de iOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia nie będą wysyłane, dopóki nie włączysz powiadomień Simple GLP w Ustawieniach iOS."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在 iOS 設定中開啟 Simple GLP 通知，提醒才會生效。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания не будут приходить, пока вы не включите уведомления Simple GLP в настройках iOS."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az emlékeztetők addig nem érkeznek meg, amíg be nem kapcsolod a Simple GLP értesítéseit az iOS Beállításokban."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria non verranno inviati finché non attivi le notifiche di Simple GLP nelle Impostazioni di iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen werden erst gesendet, wenn du Mitteilungen für Simple GLP in den iOS-Einstellungen aktivierst."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels ne seront pas envoyés tant que vous n’aurez pas activé les notifications de Simple GLP dans les Réglages iOS."
          }
        }
      }
    },
