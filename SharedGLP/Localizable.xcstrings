    "A heads-up a week before you run out, based on what you log.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A heads-up a week before you run out, based on what you log."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso uma semana antes de o estoque acabar, com base nos registros."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiklerine göre, stok bitmeden bir hafta önce hatırlatma."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aviso una semana antes de que se agote lo que tienes, según tus registros."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienie na tydzień przed końcem zapasu, na podstawie Twoich wpisów."
