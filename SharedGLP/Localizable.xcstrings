    "Simple GLP does not provide medical advice. Always follow your prescriber’s instructions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP does not provide medical advice. Always follow your prescriber’s instructions."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Simple GLP não oferece orientação médica. Siga sempre as instruções do profissional que prescreveu seu tratamento."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP tıbbi tavsiye vermez. Her zaman ilacını yazan sağlık uzmanının talimatlarına uy."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP no ofrece asesoramiento médico. Sigue siempre las indicaciones de quien te recetó el medicamento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP nie udziela porad medycznych. Zawsze stosuj się do zaleceń osoby, która przepisała Ci lek."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP 不提供醫療建議。請務必遵照處方醫療人員的指示。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP не дает медицинских рекомендаций. Всегда следуйте указаниям специалиста, назначившего препарат."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Simple GLP nem nyújt orvosi tanácsot. Mindig kövesd a gyógyszert felíró szakember utasításait."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP non fornisce consigli medici. Segui sempre le indicazioni del professionista che ti ha prescritto il farmaco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP bietet keine medizinische Beratung. Befolge immer die Anweisungen der Person, die dir das Medikament verschrieben hat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP ne fournit pas de conseils médicaux. Suivez toujours les consignes du professionnel qui vous a prescrit ce médicament."
          }
        }
      }
    },
