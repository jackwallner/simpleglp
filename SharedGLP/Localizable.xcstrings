    "Trial wasn't started. Tap again, or pick a different plan.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trial wasn't started. Tap again, or pick a different plan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste não começou. Toque novamente ou escolha outro plano."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme başlamadı. Tekrar dokun veya başka bir plan seç."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba no comenzó. Toca de nuevo o elige otro plan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okres próbny się nie rozpoczął. Dotknij ponownie lub wybierz inny plan."
