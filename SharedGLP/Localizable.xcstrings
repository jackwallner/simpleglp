    "Import a Simple GLP CSV export to restore your dose history. Imported doses are added; they don't replace existing entries.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import a Simple GLP CSV export to restore your dose history. Imported doses are added; they don't replace existing entries."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe um arquivo CSV do Simple GLP para restaurar seu histórico de doses. As doses importadas serão adicionadas sem substituir os registros existentes."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doz geçmişini geri yüklemek için bir Simple GLP CSV dosyası aktar. Aktarılan dozlar eklenir, mevcut kayıtların yerine geçmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un archivo CSV de Simple GLP para recuperar tu historial de dosis. Las dosis importadas se añaden sin reemplazar las entradas existentes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportuj plik CSV z Simple GLP, aby przywrócić historię dawek. Zaimportowane dawki zostaną dodane, nie zastąpią obecnych wpisów."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入 Simple GLP CSV 檔案以還原劑量記錄。匯入的劑量會新增，不會取代現有記錄。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте CSV-файл Simple GLP, чтобы восстановить историю доз. Импортированные дозы добавятся к записям и не заменят существующие."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Importálj Simple GLP CSV-fájlt az adagolási előzmények visszaállításához. Az importált adagok hozzáadódnak a meglévő bejegyzésekhez, nem helyettesítik őket."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa un file CSV di Simple GLP per ripristinare la cronologia delle dosi. Le dosi importate si aggiungono senza sostituire le registrazioni esistenti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere einen Simple GLP CSV-Export, um deinen Dosisverlauf wiederherzustellen. Importierte Dosen werden hinzugefügt und ersetzen keine vorhandenen Einträge."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez un fichier CSV Simple GLP pour restaurer votre historique de doses. Les doses importées sont ajoutées sans remplacer les saisies existantes."
          }
        }
      }
    },
