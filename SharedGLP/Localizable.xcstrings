    "Purchase pending. Pro isn't active yet. Refresh status or continue free while activation finishes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Purchase pending. Pro isn't active yet. Refresh status or continue free while activation finishes."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra pendente. O Pro ainda não está ativo. Atualize o status ou continue grátis enquanto a ativação termina."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satın alma beklemede. Pro henüz etkin değil. Durumu yenile veya etkinleşmesini beklerken ücretsiz devam et."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compra pendiente. Pro aún no está activo. Actualiza el estado o continúa gratis mientras termina la activación."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakup oczekuje. Pro nie jest jeszcze aktywne. Odśwież status lub korzystaj bezpłatnie do zakończenia aktywacji."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "購買處理中，Pro 尚未啟用。請重新整理狀態，或在啟用完成前免費繼續使用。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка обрабатывается. Pro еще не активен. Обновите статус или продолжайте бесплатно, пока идет активация."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A vásárlás függőben van. A Pro még nem aktív. Frissítsd az állapotot, vagy folytasd ingyen, amíg befejeződik az aktiválás."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisto in sospeso. Pro non è ancora attivo. Aggiorna lo stato o continua gratis mentre termina l’attivazione."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kauf steht aus. Pro ist noch nicht aktiv. Aktualisiere den Status oder nutze die App kostenlos, bis die Aktivierung abgeschlossen ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Achat en attente. Pro n’est pas encore actif. Actualisez le statut ou continuez gratuitement pendant l’activation."
          }
        }
      }
    },
    "No products returned for %@. Check App Store Connect / StoreKit config.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No products returned for %@. Check App Store Connect / StoreKit config."
