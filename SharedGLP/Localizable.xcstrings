    "Pick how you take it, then your medication and current dose.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick how you take it, then your medication and current dose."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha como você usa o medicamento, depois selecione o nome e a dose atual."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasıl kullandığını seç, ardından ilacını ve mevcut dozunu belirle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo lo tomas y luego selecciona el medicamento y la dosis actual."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz sposób przyjmowania, a następnie lek i aktualną dawkę."
          }
        },
        "zh-Hant": {
