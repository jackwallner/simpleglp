            "value": "Otomatik yenilenir. Ayarlar'dan bitişten en az 24 saat önce istediğin zaman iptal edebilirsin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente. Puedes cancelarla en Configuración al menos 24 horas antes de que termine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odnawia się automatycznie. Możesz anulować w Ustawieniach co najmniej 24 godziny przed końcem."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會自動續訂。你可隨時在設定中取消，最晚請於到期前 24 小時取消。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автопродление. Отменить можно в настройках не позднее чем за 24 часа до окончания."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikusan megújul. A Beállításokban bármikor lemondhatod, legalább 24 órával a lejárat előtt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova automaticamente. Puoi annullare nelle Impostazioni almeno 24 ore prima della scadenza."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verlängert sich automatisch. Du kannst mindestens 24 Stunden vor Ablauf jederzeit in den Einstellungen kündigen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Renouvellement automatique. Vous pouvez annuler dans les Réglages au moins 24 heures avant la fin."
          }
        }
      }
    },
