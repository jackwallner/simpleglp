    "Export every logged dose as a CSV file you can share or back up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export every logged dose as a CSV file you can share or back up."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte todas as doses registradas em um arquivo CSV para compartilhar ou salvar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen tüm dozları paylaşabileceğin veya yedekleyebileceğin bir CSV dosyası olarak dışa aktar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta todas las dosis registradas a un archivo CSV que puedes compartir o guardar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj każdą zarejestrowaną dawkę jako plik CSV, który możesz udostępnić lub skopiować."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將所有劑量記錄匯出為 CSV 檔案，以便分享或備份。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортируйте каждую зарегистрированную дозу в виде файла CSV, которым вы можете поделиться или создать резервную копию."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportáld az összes naplózott adagot CSV-fájlba, amelyet megoszthatsz vagy menthetsz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esporta tutte le dosi registrate in un file CSV da condividere o salvare."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportiere alle erfassten Dosen als CSV-Datei, die du teilen oder sichern kannst."
          }
        },
