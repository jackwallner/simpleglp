        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada comprimido registrado é descontado deste número. Você receberá um aviso %#@n@ antes de acabar."
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg dia"
