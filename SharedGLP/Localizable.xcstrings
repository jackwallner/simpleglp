          }
        }
      }
    },
    "Add dose changes from your prescriber in advance. On each step's start date, new logs use that step's dose by default.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add dose changes from your prescriber in advance. On each step's start date, new logs use that step's dose by default."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadastre antes as mudanças de dose indicadas pelo profissional que prescreve seu tratamento. A partir da data de cada etapa, novos registros usam essa dose por padrão."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlacını yazan sağlık uzmanının belirlediği doz değişikliklerini önceden ekle. Her adımın başlangıç tarihinde yeni kayıtlar varsayılan olarak o dozu kullanır."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrega con anticipación los cambios de dosis que te indicó quien te recetó el medicamento. Desde la fecha de cada etapa, los nuevos registros usarán esa dosis de forma predeterminada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj z wyprzedzeniem zmiany dawki zalecone przez lekarza. Od daty rozpoczęcia danego etapu nowe wpisy będą domyślnie używać tej dawki."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請預先加入處方醫療人員指示的劑量變更。每個階段開始後，新記錄會預設使用該階段的劑量。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заранее добавьте изменения дозы, назначенные специалистом. С даты начала каждого этапа новые записи будут использовать эту дозу по умолчанию."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Előre add hozzá az orvos által előírt dózismódosításokat. Az egyes lépések kezdőnapjától az új bejegyzések alapértelmezés szerint az adott dózist használják."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi in anticipo le modifiche di dose prescritte dal professionista che ti segue. Dalla data di inizio di ogni fase, le nuove registrazioni useranno quella dose come valore predefinito."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge vorab die von deiner Arztpraxis festgelegten Dosisänderungen hinzu. Ab dem Startdatum jeder Stufe wird diese Dosis bei neuen Einträgen standardmäßig verwendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez à l’avance les changements de dose indiqués par le professionnel qui vous suit. À partir de la date de chaque étape, les nouvelles entrées utiliseront cette dose par défaut."
          }
        }
      }
    },
