    "Your wait ticks down on the Lock Screen and in the Dynamic Island.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your wait ticks down on the Lock Screen and in the Dynamic Island."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A contagem da espera aparece na Tela Bloqueada e na Dynamic Island."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleme sayacı Kilit Ekranı’nda ve Dynamic Island’da görünür."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La espera se cuenta en la pantalla de bloqueo y en Dynamic Island."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odliczanie jest widoczne na ekranie blokady i w Dynamic Island."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待倒數會顯示在鎖定畫面和 Dynamic Island。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсчёт ожидания отображается на экране блокировки и в Dynamic Island."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A visszaszámlálás a zárolási képernyőn és a Dynamic Islanden is látható."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il conto alla rovescia è visibile sulla schermata di blocco e nella Dynamic Island."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wartezeit zählt auf dem Sperrbildschirm und in der Dynamic Island herunter."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte à rebours s’affiche sur l’écran verrouillé et dans la Dynamic Island."
