    "When enabled, Simple GLP reads optional Health data when you log a dose. It never writes back to Apple Health.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, Simple GLP reads optional Health data when you log a dose. It never writes back to Apple Health."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, o Simple GLP lê dados opcionais de Saúde ao registrar uma dose. Não grava nenhum dado no Apple Health."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirildiğinde Simple GLP, doz kaydettiğinde isteğe bağlı Sağlık verilerini okur. Apple Health'e hiçbir veri yazmaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al activarlo, Simple GLP lee datos opcionales de Salud cuando registras una dosis. Nunca escribe datos en Apple Health."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po włączeniu Simple GLP odczytuje opcjonalne dane zdrowotne podczas zapisywania dawki. Nie zapisuje danych w Apple Health."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用後，Simple GLP 會在記錄劑量時讀取選用的健康資料，不會寫入 Apple Health。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если функция включена, Simple GLP считывает дополнительные данные о здоровье при записи дозы и не записывает данные в Apple Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekapcsolás után a Simple GLP opcionális egészségügyi adatokat olvas a dózis rögzítésekor. Nem ír adatot az Apple Healthbe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivata, Simple GLP legge i dati Salute facoltativi quando registri una dose. Non scrive dati su Apple Health."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, liest Simple GLP beim Erfassen einer Dosis optionale Gesundheitsdaten. Es schreibt nichts in Apple Health."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois activée, Simple GLP lit les données de santé facultatives lors de l’enregistrement d’une dose. Aucune donnée n’est écrite dans Apple Health."
          }
        }
      }
    },
