    "Most of your logged pills happen on %@. Want to log today’s dose?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most of your logged pills happen on %@. Want to log today’s dose?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você costuma registrar os comprimidos às %1$@. Quer registrar a dose de hoje?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tablet kayıtlarını genellikle %1$@ günü yapıyorsun. Bugünkü dozu kaydetmek ister misin?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sueles registrar las pastillas los %1$@. ¿Quieres registrar la dosis de hoy?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najczęściej zapisujesz tabletki w dzień: %1$@. Zapisać dzisiejszą dawkę?"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你通常在 %1$@ 記錄藥錠。要記錄今天的劑量嗎？"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чаще всего вы записываете таблетки в один и тот же день недели (%1$@). Записать сегодняшнюю дозу?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A tablettákat leggyakrabban %1$@ napján rögzíted. Rögzíted a mai adagot is?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di solito registri le compresse di %1$@. Vuoi registrare la dose di oggi?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du erfasst deine Tabletten meist am %1$@. Möchtest du die heutige Dosis eintragen?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous enregistrez généralement vos comprimés le %1$@. Enregistrer la dose d’aujourd’hui ?"
          }
        }
      }
    },
