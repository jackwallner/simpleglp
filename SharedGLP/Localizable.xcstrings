        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В дни, когда вы уже записали приём таблетки, напоминание пропускается."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azokon a napokon nem küldünk emlékeztetőt, amikor már rögzítetted a tablettát."
