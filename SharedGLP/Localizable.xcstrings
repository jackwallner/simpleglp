    "Across %lld logged pills. Pro adds a Lock Screen countdown.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Across %lld logged pills. Pro adds a Lock Screen countdown."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com %1$lld comprimidos registrados. O Pro adiciona a contagem na Tela Bloqueada."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld tablet kaydında Pro, kilit ekranı geri sayımı sunar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con %1$lld pastillas registradas, Pro añade una cuenta regresiva en la pantalla bloqueada."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zapisaniu %1$lld tabletek Pro dodaje odliczanie na ekranie blokady."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "記錄 %1$lld 錠後，Pro 可在鎖定畫面顯示倒數。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После записи %1$lld таблеток Pro добавит обратный отсчет на экране блокировки."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld rögzített tabletta után a Pro visszaszámlálást ad a zárolási képernyőhöz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo aver registrato %1$lld compresse, Pro aggiunge il conto alla rovescia sulla schermata di blocco."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach %1$lld erfassten Tabletten zeigt Pro einen Countdown auf dem Sperrbildschirm."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après %1$lld comprimés enregistrés, Pro ajoute un compte à rebours sur l’écran verrouillé."
          }
        }
      }
    },
    "Across %lld logged shots. Pro adds dose-day reminders.": {
