            "state": "translated",
            "value": "Your supply could not be saved. Please try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar seu estoque. Tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stok kaydedilemedi. Lütfen yeniden dene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el inventario. Inténtalo de nuevo."
          }
        },
        "pl": {
