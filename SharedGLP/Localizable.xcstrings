    "A second reminder a few hours after your usual time. Quiet hours respected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A second reminder a few hours after your usual time. Quiet hours respected."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um segundo lembrete algumas horas depois do seu horário habitual. Os horários silenciosos são respeitados."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genellikle aldığın saatten birkaç saat sonra ikinci bir hatırlatma. Sessiz saatlere uyulur."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un segundo recordatorio unas horas después de tu hora habitual. Se respetan las horas de silencio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Drugie przypomnienie kilka godzin po zwykłej porze. Uwzględnia godziny ciszy."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在平常時間後數小時再提醒一次，並遵守勿擾時段。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторное напоминание через несколько часов после обычного времени. В тихие часы уведомления не приходят."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Második emlékeztető a szokásos időpont után néhány órával. Figyelembe veszi a csendes időszakot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un secondo promemoria qualche ora dopo il tuo orario abituale. Le ore di silenzio sono rispettate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine zweite Erinnerung einige Stunden nach deiner üblichen Zeit. Ruhezeiten werden berücksichtigt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un second rappel quelques heures après votre horaire habituel. Les heures de silence sont respectées."
          }
        }
      }
    },
