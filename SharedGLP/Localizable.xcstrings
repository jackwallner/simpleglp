    "Tracking only. Simple GLP isn't medical advice and doesn't diagnose or treat any condition.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking only. Simple GLP isn't medical advice and doesn't diagnose or treat any condition."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Simple GLP serve apenas para registrar. Não oferece orientação médica, não diagnostica nem trata nenhuma condição."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP yalnızca takip içindir. Tıbbi tavsiye vermez, herhangi bir durumu teşhis veya tedavi etmez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP solo sirve para llevar un registro. No da consejos médicos, no diagnostica ni trata ninguna condición."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP służy tylko do śledzenia. Nie udziela porad medycznych, nie diagnozuje ani nie leczy żadnych schorzeń."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP 僅供追蹤記錄，不提供醫療建議，也不診斷或治療任何疾病。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP предназначен только для ведения записей. Он не дает медицинских рекомендаций, не диагностирует и не лечит заболевания."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Simple GLP csak nyomon követésre szolgál. Nem ad orvosi tanácsot, nem diagnosztizál és nem kezel semmilyen állapotot."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP serve solo a tenere traccia. Non fornisce consigli medici, non diagnostica né tratta alcuna patologia."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP dient nur zur Dokumentation. Die App berät nicht medizinisch, stellt keine Diagnosen und behandelt keine Erkrankungen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Simple GLP sert uniquement au suivi. L’app ne donne pas de conseils médicaux, ne pose aucun diagnostic et ne traite aucune maladie."
          }
        }
      }
    },
