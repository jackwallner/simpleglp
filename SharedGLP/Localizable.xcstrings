                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pastilla registrada se descuenta de esta cantidad. Recibirás un aviso %#@n@ antes de que se acaben."
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg día"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg días"
                    }
                  }
                }
              }
            }
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda zapisana tabletka zmniejsza tę liczbę. Otrzymasz przypomnienie, gdy do końca zapasu zostanie %#@n@."
          },
          "substitutions": {
