    "You already logged a pill that day. This adds a second one.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You already logged a pill that day. This adds a second one."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você já registrou um comprimido nesse dia. Isto adiciona um segundo."
          }
        },
