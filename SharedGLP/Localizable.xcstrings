    "No countdown. Set one if your instructions include a wait before food or drink.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No countdown. Set one if your instructions include a wait before food or drink."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem contagem. Defina uma se suas instruções indicarem esperar antes de comer ou beber."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayaç yok. Talimatlarında yemek veya içmeden önce bekleme varsa bir süre belirle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta regresiva. Configura una si tus indicaciones incluyen esperar antes de comer o beber."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez odliczania. Ustaw czas, jeśli masz zalecone czekanie przed jedzeniem lub piciem."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不倒數。如果你的指示要求進食或飲水前等待，請設定時間。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без отсчета. Установите время, если по вашим указаниям нужно подождать перед едой или питьем."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nincs visszaszámlálás. Állíts be időt, ha az utasításaid szerint várnod kell evés vagy ivás előtt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun conto alla rovescia. Impostane uno se le tue indicazioni prevedono di aspettare prima di mangiare o bere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Countdown. Stelle eine Wartezeit ein, wenn deine Vorgaben eine Pause vor dem Essen oder Trinken vorsehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte à rebours. Définissez un délai si vos consignes prévoient d’attendre avant de manger ou de boire."
          }
        }
      }
    },
    "How often do you dose?": {
