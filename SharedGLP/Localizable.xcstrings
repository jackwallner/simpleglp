    "Every pill you log counts down from this number. You’ll get a heads-up about %lld days before you run out.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every pill you log counts down from this number. You’ll get a heads-up about %#@n@ before you run out."
          },
          "substitutions": {
            "n": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg day"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg days"
                    }
                  }
                }
              }
            }
