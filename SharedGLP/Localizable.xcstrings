    "Quiet hours respected. Your usual Tuesday window is 8:00-10:00 AM.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet hours respected. Your usual Tuesday window is 8:00-10:00 AM."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário silencioso é respeitado. Seu período habitual às terças é das 8:00 às 10:00."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessiz saatlere uyulur. Salı günleri alışık olduğun saat aralığı 08.00 ile 10.00 arası."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se respetan las horas de silencio. Tu horario habitual los martes es de 8:00 a 10:00."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwzględniamy godziny ciszy. We wtorki zwykle zapisujesz dawkę między 8:00 a 10:00."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "會遵守靜音時段。你通常在星期二 8:00 到 10:00 記錄。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихие часы учитываются. Обычно во вторник вы записываете дозу с 8:00 до 10:00."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A csendes időszakot figyelembe vesszük. Keddenként általában 8 és 10 óra között rögzítesz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ore di silenzio sono rispettate. Il tuo intervallo abituale del martedì è dalle 8:00 alle 10:00."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhezeiten werden berücksichtigt. Dein übliches Zeitfenster am Dienstag ist von 8:00 bis 10:00 Uhr."
          }
        },
        "fr": {
