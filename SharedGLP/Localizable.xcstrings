    "Deleting an entry removes its dose, schedule status, and any logged details and Health context. This can't be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting an entry removes its dose, schedule status, and any logged details and Health context. This can't be undone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir uma entrada remove a dose, o status do cronograma, os detalhes registrados e o contexto do Apple Saúde. Essa ação não pode ser desfeita."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kaydı silmek dozu, plan durumunu, kaydedilen ayrıntıları ve sağlık verilerini kaldırır. Bu işlem geri alınamaz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar una entrada, se borran la dosis, su estado en el programa, los detalles registrados y el contexto de Salud. No se puede deshacer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie wpisu usuwa dawkę, status harmonogramu oraz zapisane szczegóły i dane Zdrowia. Tej operacji nie można cofnąć."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除記錄會移除劑量、時程狀態、已記錄的詳細資料及健康資料背景。此操作無法復原。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При удалении записи удаляются доза, статус по расписанию, подробности и данные о здоровье. Это действие нельзя отменить."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejegyzés törlésével az adag, az ütemezés állapota, a rögzített részletek és az egészségügyi adatok is törlődnek. A művelet nem vonható vissza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminando una voce rimuovi la dose, lo stato del programma, i dettagli registrati e il contesto dei dati Salute. L’operazione non può essere annullata."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Löschen eines Eintrags werden die Dosis, der Planstatus sowie erfasste Details und Gesundheitsdaten entfernt. Dieser Vorgang kann nicht rückgängig gemacht werden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La suppression d’une entrée efface la dose, son état dans le programme, les détails enregistrés et le contexte de santé. Cette action est irréversible."
          }
        }
      }
    },
