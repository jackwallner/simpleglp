    "Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings > Apple ID > Subscriptions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-renews unless cancelled at least 24 hours before the end of the current period. Manage or cancel in Settings > Apple ID > Subscriptions."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura é renovada automaticamente, a menos que seja cancelada pelo menos 24 horas antes do fim do período atual. Gerencie ou cancele em Ajustes > Apple ID > Assinaturas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut dönem bitmeden en az 24 saat önce iptal etmezsen otomatik yenilenir. Ayarlar > Apple ID > Abonelikler bölümünden yönet veya iptal et."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se renueva automáticamente, a menos que canceles al menos 24 horas antes de que termine el periodo actual. Adminístrala o cancélala en Configuración > Apple ID > Suscripciones."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subskrypcja odnawia się automatycznie, chyba że anulujesz ją co najmniej 24 godziny przed końcem bieżącego okresu. Zarządzaj nią lub anuluj w Ustawieniach > Apple ID > Subskrypcje."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你在目前週期結束前至少 24 小時取消，否則會自動續訂。請前往「設定」>「Apple ID」>「訂閱項目」管理或取消。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка продлится автоматически, если не отменить ее минимум за 24 часа до конца текущего периода. Управление и отмена: «Настройки» > Apple ID > «Подписки»."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az előfizetés automatikusan megújul, hacsak legalább 24 órával a jelenlegi időszak vége előtt le nem mondod. Kezelés vagy lemondás: Beállítások > Apple ID > Előfizetések."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si rinnova automaticamente, a meno che tu non annulli almeno 24 ore prima della fine del periodo in corso. Gestisci o annulla in Impostazioni > ID Apple > Abbonamenti."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abo verlängert sich automatisch, wenn du es nicht mindestens 24 Stunden vor Ende des aktuellen Zeitraums kündigst. Verwalte oder kündige es unter Einstellungen > Apple-ID > Abonnements."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’abonnement se renouvelle automatiquement, sauf si vous l’annulez au moins 24 heures avant la fin de la période en cours. Gérez-le ou annulez-le dans Réglages > Identifiant Apple > Abonnements."
          }
        }
      }
    },
    "Couldn't refresh your subscription status. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't refresh your subscription status. Check your connection and try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível atualizar o status da assinatura. Verifique sua conexão e tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelik durumu yenilenemedi. Bağlantını kontrol edip yeniden dene."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar el estado de la suscripción. Revisa tu conexión e inténtalo de nuevo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odświeżyć statusu subskrypcji. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法更新訂閱狀態。請檢查網路連線後再試一次。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить статус подписки. Проверьте подключение и попробуйте еще раз."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült frissíteni az előfizetés állapotát. Ellenőrizd a kapcsolatot, és próbáld újra."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aggiornare lo stato dell’abbonamento. Controlla la connessione e riprova."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Abo-Status konnte nicht aktualisiert werden. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’actualiser le statut de l’abonnement. Vérifiez votre connexion et réessayez."
          }
        }
      }
    },
