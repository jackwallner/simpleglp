    "Your medication plan could not be saved. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your medication plan could not be saved. Please try again."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar seu plano de medicamento. Tente novamente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlaç planın kaydedilemedi. Lütfen yeniden dene."
          }
        },
        "es": {
