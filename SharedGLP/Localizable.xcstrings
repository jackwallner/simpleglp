    "Your %@ dose was planned for today at %@. Log it after you take it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ dose was planned for today at %@. Log it after you take it."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua dose de %1$@ estava prevista para hoje às %2$@. Registre depois de tomá-la."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ dozun bugün saat %2$@ için planlandı. İlacını aldıktan sonra kaydet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu dosis de %1$@ estaba prevista hoy a las %2$@. Regístrala después de tomarla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dawka %1$@ była zaplanowana na dziś o %2$@. Zapisz ją po przyjęciu."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 預定於今天 %2$@ 使用。請在用藥後記錄。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доза препарата %1$@ запланирована на сегодня, %2$@. Запишите ее после приема."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %1$@ adag ma %2$@ időpontra van beütemezve. Rögzítsd a bevétele után."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dose di %1$@ era prevista oggi alle %2$@. Registrala dopo averla assunta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dosis %1$@ ist heute um %2$@ geplant. Erfasse sie nach der Einnahme."
          }
        },
